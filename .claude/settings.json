{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run python -m pytest)",
      "Bash(uv run python -m pyright *)",
      "Bash(uv run python -m pyright)",
      "Bash(uv run python -m pre_commit run *)",
      "Bash(uv run ruff *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh repo create *)",
      "Bash(gh release *)",
      "Bash(uv publish *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_before_stop.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
